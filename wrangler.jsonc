{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "droydcreatives",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "customer_enquiries",
			"database_id": "322f6ff8-8e92-4d57-83c7-f4cd906aff5d",
		}
	]
}